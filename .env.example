# Trascrvibe - esempio di configurazione. Copia in .env e modifica.
# NON inserire chiavi segrete: Trascrvibe non richiede alcuna API key.

# Directory dei dati (upload, database, esportazioni)
TRSV_DATA_DIR=data

# Dimensione massima upload in megabyte (5120 MB = 5 GB)
TRSV_MAX_UPLOAD_MB=5120

# Modello Whisper: tiny | base | small | medium | large-v3
# tiny/base = veloci · small/medium = bilanciati · large-v3 = massimo dettaglio
TRSV_DEFAULT_MODEL=base

# Dispositivo: auto | cpu | cuda
TRSV_DEVICE=auto

# Precisione di calcolo: auto = int8 su CPU (veloce), float16 su GPU NVIDIA
TRSV_COMPUTE_TYPE=auto

# Lingua sorgente: codice ISO (it, en, ...) oppure "auto" per rilevamento automatico
TRSV_LANGUAGE=auto

# Provider: "faster-whisper" (reale, locale) oppure "demo" (sviluppo, output marcato DEMO)
TRSV_DEFAULT_PROVIDER=faster-whisper
